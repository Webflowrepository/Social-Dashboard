---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Registro de publicaciones y performance de GILD." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>GILD Content Registry</title>
    <link rel="stylesheet" href="/dashboard/styles.css?v=gild-registry-2" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Dashboard navigation">
        <a class="brand-lockup" href="/" aria-label="GILD home">
          <img src="/assets/logos/logo-gild.png" alt="GILD" />
        </a>
        <div class="nav-list">
          <a href="#website">Website</a>
          <a href="#newsletter">Newsletter</a>
          <a href="#channels">Canales</a>
          <a href="#registro">Registro</a>
          <a href="#setup">Fuentes</a>
        </div>
        <div class="header-actions">
          <span id="sidebar-mode" class="mode-pill">Loading</span>
          <a class="join-button" href="#setup">Fuentes</a>
        </div>
      </nav>
    </header>

    <main class="dashboard-main">
      <div class="shell" id="overview">
        <section class="dashboard-head">
          <div>
            <p class="eyebrow">GILD Content Registry</p>
            <h1>Registro de publicaciones</h1>
            <p class="hero-copy">Que se publico, donde salio, como le fue y que falta conectar para que el registro se complete solo.</p>
          </div>
          <div class="sync-status">
            <span id="sync-dot" class="dot ok"></span>
            <div>
              <strong id="sync-label">Cargando</strong>
              <span id="sync-time">--</span>
            </div>
          </div>
        </section>

        <section class="focus-grid">
          <article class="board insight-board" id="website">
            <div class="board-header">
              <div>
                <h2>Website</h2>
                <p>Views por seccion de gildhq.com para detectar que partes de la web conviene mejorar o empujar.</p>
              </div>
              <div class="mini-toggle" data-range-group="website">
                <button class="range-button active" data-website-range="day" type="button">Dia</button>
                <button class="range-button" data-website-range="week" type="button">Semana</button>
                <button class="range-button" data-website-range="month" type="button">Mes</button>
              </div>
            </div>
            <div class="insight-layout">
              <div class="bar-list" id="website-bars"></div>
              <aside class="read-box" id="website-read"></aside>
            </div>
          </article>

          <article class="board insight-board" id="newsletter">
            <div class="board-header">
              <div>
                <h2>Newsletter</h2>
                <p>Issues de Beehiiv ordenados por performance para decidir que temas repetir, cortar o llevar a LinkedIn/Instagram.</p>
              </div>
              <div class="mini-toggle" data-range-group="newsletter">
                <button class="range-button active" data-newsletter-range="month" type="button">Mes</button>
                <button class="range-button" data-newsletter-range="week" type="button">Semana</button>
                <button class="range-button" data-newsletter-range="all" type="button">Todo</button>
              </div>
            </div>
            <div class="insight-layout">
              <div class="bar-list" id="newsletter-bars"></div>
              <aside class="read-box" id="newsletter-read"></aside>
            </div>
          </article>
        </section>

        <section class="summary-grid compact-summary" id="summary-grid"></section>

        <section class="control-bar" aria-label="Filtros">
          <div class="period-toggle" role="group" aria-label="Periodo">
            <button class="period-button active" data-period="month" type="button">Mes</button>
            <button class="period-button" data-period="week" type="button">Semana</button>
            <button class="period-button" data-period="all" type="button">Todo</button>
          </div>
          <div class="filter-row">
            <select id="month-filter" aria-label="Filtrar por periodo"></select>
            <select id="content-channel-filter" aria-label="Filtrar por canal">
              <option value="all">Todos los canales</option>
              <option value="linkedin">LinkedIn</option>
              <option value="instagram">Instagram</option>
              <option value="newsletter">Newsletter</option>
              <option value="website">Website</option>
              <option value="youtube">YouTube</option>
              <option value="spotify">Spotify</option>
            </select>
          </div>
        </section>

        <section class="board" id="registro">
          <div class="board-header">
            <div>
              <h2>Registro</h2>
              <p>Las filas reales vienen de APIs. Las filas marcadas como proxy son temporales hasta conectar la fuente.</p>
            </div>
          </div>
          <div class="content-table-wrap">
            <table class="content-table">
              <thead>
                <tr>
                  <th>Publicacion</th>
                  <th>Canal</th>
                  <th>Fecha</th>
                  <th>Resultado</th>
                  <th>Score</th>
                  <th>Lectura</th>
                </tr>
              </thead>
              <tbody id="content-table-body"></tbody>
            </table>
          </div>
        </section>

        <section class="board" id="channels">
          <div class="board-header">
            <div>
              <h2>Canales</h2>
              <p>LinkedIn e Instagram son prioridad. Newsletter y website ayudan a decidir temas; YouTube y Spotify alimentan profundidad.</p>
            </div>
          </div>
          <div class="comparison-grid" id="comparison-grid"></div>
        </section>

        <section class="board setup-grid" id="setup">
          <div>
            <h2>Que falta conectar</h2>
            <p class="setup-copy">
              Para que el registro se popule automaticamente necesitamos credenciales de lectura por fuente. El sync horario ya esta instalado.
            </p>
          </div>
          <div class="queue-list" id="queue-list"></div>
        </section>
      </div>
    </main>

    <script src="/dashboard/app.js?v=gild-registry-2" type="module"></script>
  </body>
</html>
