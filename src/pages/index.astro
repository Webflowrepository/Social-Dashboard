---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Content intelligence dashboard de GILD." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>GILD Content Intelligence</title>
    <link rel="stylesheet" href="/dashboard/styles.css?v=gild-learning-3" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Dashboard navigation">
        <a class="brand-lockup" href="/" aria-label="GILD home">
          <img src="/assets/logos/logo-gild.png" alt="GILD" />
        </a>
        <div class="nav-list">
          <a href="#overview">Decisiones</a>
          <a href="#channels">Canales</a>
          <a href="#content-intelligence">Intelligence</a>
          <a href="#learnings">Learnings</a>
          <a href="#data-health">Data</a>
        </div>
        <div class="header-actions">
          <span id="sidebar-mode" class="mode-pill">Loading</span>
          <a class="join-button" href="#data-health">Fuentes</a>
        </div>
      </nav>
    </header>

    <main class="dashboard-main">
      <div class="shell learning-shell">
        <section class="dashboard-head" id="overview">
          <div>
            <p class="eyebrow">GILD Content Intelligence</p>
            <h1>Que posteos conviene repetir, adaptar o cortar</h1>
            <p class="hero-copy">Una lectura por periodo para comparar piezas concretas, detectar patrones y decidir hacia donde mover el contenido.</p>
          </div>
          <div class="sync-status">
            <span id="sync-dot" class="dot ok"></span>
            <div>
              <strong id="sync-label">Cargando</strong>
              <span id="sync-time">--</span>
            </div>
          </div>
        </section>

        <section class="analysis-controls" aria-label="Filtros globales">
          <div>
            <span>Periodo</span>
            <div class="period-toggle" role="group" aria-label="Periodo">
              <button class="period-button active" data-range="30d" type="button">30 dias</button>
              <button class="period-button" data-range="7d" type="button">7 dias</button>
              <button class="period-button" data-range="this-month" type="button">Este mes</button>
              <button class="period-button" data-range="last-month" type="button">Mes pasado</button>
              <button class="period-button" data-range="3m" type="button">3 meses</button>
              <button class="period-button" data-range="6m" type="button">6 meses</button>
              <button class="period-button" data-range="all" type="button">Todo</button>
            </div>
          </div>
          <div class="filter-row">
            <label>
              Canal
              <select id="global-channel-filter" aria-label="Filtrar canal">
                <option value="all">Todos</option>
                <option value="instagram">Instagram</option>
                <option value="linkedin">LinkedIn</option>
                <option value="newsletter">Newsletter</option>
                <option value="website">Website</option>
                <option value="youtube">YouTube</option>
              </select>
            </label>
          </div>
        </section>

        <section class="channel-switcher" aria-label="Elegir canal">
          <div>
            <p class="eyebrow">Elegir una vista</p>
            <h2>Que canal queres entender?</h2>
          </div>
          <div class="channel-switcher-list" id="channel-switcher-list">
            <button class="channel-switch active" data-channel="all" type="button">Resumen</button>
            <button class="channel-switch" data-channel="instagram" type="button">Instagram</button>
            <button class="channel-switch" data-channel="linkedin" type="button">LinkedIn</button>
            <button class="channel-switch" data-channel="newsletter" type="button">Newsletter</button>
            <button class="channel-switch" data-channel="website" type="button">Website</button>
            <button class="channel-switch" data-channel="youtube" type="button">YouTube</button>
          </div>
        </section>

        <section class="decision-grid" id="overview-grid"></section>

        <section class="board question-board">
          <div class="board-header">
            <div>
              <h2>Decision check</h2>
              <p>Lo minimo para decidir el proximo movimiento sin perderse en metricas generales.</p>
            </div>
          </div>
          <div class="quick-grid" id="quick-check"></div>
        </section>

        <section class="board">
          <div class="board-header">
            <div>
              <h2>Comparador de posteos</h2>
              <p>Que piezas ganaron por atencion, accion o distribucion. Mirar diferencias entre posteos, no solo totales.</p>
            </div>
          </div>
          <div class="top-content-grid" id="top-content"></div>
        </section>

        <section class="channel-stack" id="channels">
          <div class="section-heading">
            <p class="eyebrow">Channel analysis</p>
            <h2>Canales separados</h2>
          </div>
          <div id="channel-sections"></div>
        </section>

        <section class="board" id="content-intelligence">
          <div class="board-header">
            <div>
              <h2>Content Intelligence</h2>
              <p>Patrones por plataforma, formato y metadata disponible. No inventa topicos si no existen en los datos.</p>
            </div>
          </div>
          <div class="intelligence-grid" id="content-intelligence-grid"></div>
        </section>

        <section class="board" id="learnings">
          <div class="board-header">
            <div>
              <h2>Learnings</h2>
              <p>Memoria institucional separando hechos, observaciones, hipotesis y recomendaciones.</p>
            </div>
          </div>
          <div class="learning-list" id="learning-list"></div>
        </section>

        <section class="board" id="content-record">
          <div class="board-header">
            <div>
              <h2>Registro completo</h2>
              <p>Deep analysis: todas las piezas del periodo, con miniatura cuando el CSV/API la trae.</p>
            </div>
          </div>
          <div class="content-table-wrap">
            <table class="content-table">
              <thead>
                <tr>
                  <th>Contenido</th>
                  <th>Canal</th>
                  <th>Fecha</th>
                  <th>Metricas</th>
                  <th>Score</th>
                  <th>Lectura</th>
                </tr>
              </thead>
              <tbody id="content-table-body"></tbody>
            </table>
          </div>
        </section>

        <section class="board setup-grid" id="data-health">
          <div>
            <h2>Data Health</h2>
            <p class="setup-copy">Estado de cada fuente. Esto queda separado de la lectura analitica para no mezclar integraciones con performance.</p>
          </div>
          <div class="queue-list" id="data-health-list"></div>
        </section>
      </div>
    </main>

    <script src="/dashboard/app.js?v=gild-learning-3" type="module"></script>
  </body>
</html>
