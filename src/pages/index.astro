---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Content intelligence dashboard de GILD." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>GILD Content intelligence</title>
    <link rel="stylesheet" href="/dashboard/styles.css?v=gild-learning-3" />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Dashboard navigation">
        <a class="brand-lockup" href="/" aria-label="GILD home">
          <img src="/assets/logos/logo-gild.png" alt="GILD" />
        </a>
        <div class="nav-list">
          <a href="#overview">Decisions</a>
          <a href="#channels">Channels</a>
          <a href="#content-intelligence">Intelligence</a>
          <a href="#learnings">Learnings</a>
          <a href="#data-health">Data</a>
        </div>
        <div class="header-actions">
          <span id="sidebar-mode" class="mode-pill">Loading</span>
          <a class="join-button" href="#data-health">Sources</a>
        </div>
      </nav>
    </header>

    <main class="dashboard-main">
      <div class="shell learning-shell">
        <section class="dashboard-head" id="overview">
          <div>
            <p class="eyebrow">GILD Content intelligence</p>
            <h1>Which posts should we repeat, adapt or stop</h1>
            <p class="hero-copy">A period-based view to compare concrete pieces, spot patterns and decide what content to make next.</p>
          </div>
          <div class="sync-status">
            <span id="sync-dot" class="dot ok"></span>
            <div>
              <strong id="sync-label">Loading</strong>
              <span id="sync-time">--</span>
            </div>
          </div>
        </section>

        <section class="analysis-controls" aria-label="Filtros globales">
          <div>
            <span>Period</span>
            <div class="period-toggle" role="group" aria-label="Period">
              <button class="period-button active" data-range="30d" type="button">30 days</button>
              <button class="period-button" data-range="7d" type="button">7 dias</button>
              <button class="period-button" data-range="this-month" type="button">This month</button>
              <button class="period-button" data-range="last-month" type="button">Last month</button>
              <button class="period-button" data-range="3m" type="button">3 months</button>
              <button class="period-button" data-range="6m" type="button">6 months</button>
              <button class="period-button" data-range="all" type="button">All time</button>
            </div>
          </div>
          <div class="filter-row">
            <label>
              Channel
              <select id="global-channel-filter" aria-label="Filtrar canal">
                <option value="all">All times</option>
                <option value="instagram">Instagram</option>
                <option value="linkedin">LinkedIn</option>
                <option value="newsletter">Newsletter</option>
                <option value="website">Website</option>
                <option value="youtube">YouTube</option>
              </select>
            </label>
          </div>
        </section>

        <section class="channel-switcher" aria-label="Choose channel">
          <div>
            <p class="eyebrow">Choose a view</p>
            <h2>Which channel do you want to understand?</h2>
          </div>
          <div class="channel-switcher-list" id="channel-switcher-list">
            <button class="channel-switch active" data-channel="all" type="button">Overview</button>
            <button class="channel-switch" data-channel="instagram" type="button">Instagram</button>
            <button class="channel-switch" data-channel="linkedin" type="button">LinkedIn</button>
            <button class="channel-switch" data-channel="newsletter" type="button">Newsletter</button>
            <button class="channel-switch" data-channel="website" type="button">Website</button>
            <button class="channel-switch" data-channel="youtube" type="button">YouTube</button>
          </div>
        </section>

        <section class="decision-grid" id="overview-grid"></section>

        <section class="board question-board">
          <div class="board-header">
            <div>
              <h2>Decision check</h2>
              <p>The minimum needed to decide what to do next without getting lost in vanity metrics.</p>
            </div>
          </div>
          <div class="quick-grid" id="quick-check"></div>
        </section>

        <section class="board">
          <div class="board-header">
            <div>
              <h2>Post comparison</h2>
              <p>See which pieces won on attention, action or distribution. Compare posts, not just totals.</p>
            </div>
          </div>
          <div class="top-content-grid" id="top-content"></div>
        </section>

        <section class="channel-stack" id="channels">
          <div class="section-heading">
            <p class="eyebrow">Channel analysis</p>
            <h2>Channels separados</h2>
          </div>
          <div id="channel-sections"></div>
        </section>

        <section class="board" id="content-intelligence">
          <div class="board-header">
            <div>
              <h2>Content intelligence</h2>
              <p>Patterns by platform, format and available metadata. No topics are invented when the data does not contain them.</p>
            </div>
          </div>
          <div class="intelligence-grid" id="content-intelligence-grid"></div>
        </section>

        <section class="board" id="learnings">
          <div class="board-header">
            <div>
              <h2>Learnings</h2>
              <p>A decision record that separates facts, observations, hypotheses and recommendations.</p>
            </div>
          </div>
          <div class="learning-list" id="learning-list"></div>
        </section>

        <section class="board" id="content-record">
          <div class="board-header">
            <div>
              <h2>Full content record</h2>
              <p>All pieces in the selected period, with thumbnails when the CSV/API provides them.</p>
            </div>
          </div>
          <div class="content-table-wrap">
            <table class="content-table">
              <thead>
                <tr>
                  <th>Contenido</th>
                  <th>Channel</th>
                  <th>Fecha</th>
                  <th>Metrics</th>
                  <th>Score</th>
                  <th>Decision</th>
                </tr>
              </thead>
              <tbody id="content-table-body"></tbody>
            </table>
          </div>
        </section>

        <section class="board setup-grid" id="data-health">
          <div>
            <h2>Data health</h2>
            <p class="setup-copy">The status of each source, kept separate from performance analysis.</p>
          </div>
          <div class="queue-list" id="data-health-list"></div>
        </section>
      </div>
    </main>

    <script src="/dashboard/app.js?v=gild-learning-3" type="module"></script>
  </body>
</html>
