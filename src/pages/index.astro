---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GILD content intelligence dashboard." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>GILD Content intelligence</title>
    <link rel="stylesheet" href="/dashboard/styles.css?v=gild-channel-grid-1" />
  </head>
  <body class="channel-start">
    <header class="site-header">
      <nav class="site-nav" aria-label="Dashboard navigation">
        <a class="brand-lockup" href="/" aria-label="GILD home">
          <img src="/assets/logos/logo-gild.png" alt="GILD" />
        </a>
        <div class="nav-list">
          <a href="#channel-picker">Choose channel</a>
          <a href="#channels">Channels</a>
          <a href="#content-intelligence">Intelligence</a>
          <a href="#learnings">Learnings</a>
        </div>
        <div class="header-actions">
          <span id="sidebar-mode" class="mode-pill">Loading</span>
          <a class="join-button" href="#data-health">Sources</a>
        </div>
      </nav>
    </header>

    <main class="dashboard-main">
      <div class="shell learning-shell">
        <section class="analysis-controls" aria-label="Global filters">
          <div>
            <span>Period</span>
            <div class="period-toggle" role="group" aria-label="Period">
              <button class="period-button" data-range="this-week" type="button">This week</button>
              <button class="period-button" data-range="this-month" type="button">This month</button>
              <button class="period-button" data-range="last-month" type="button">Last month</button>
              <button class="period-button" data-range="3m" type="button">Last 3 months</button>
              <button class="period-button active" data-range="all" type="button">All time</button>
            </div>
          </div>
          <div class="filter-row">
            <label>
              Channel
              <select id="global-channel-filter" aria-label="Filter channel">
                <option value="all">All channels</option>
                <option value="instagram">Instagram</option>
                <option value="linkedin">LinkedIn</option>
                <option value="newsletter">Newsletter</option>
                <option value="website">Website</option>
                <option value="youtube">YouTube</option>
                <option value="luma">Luma</option>
              </select>
            </label>
          </div>
        </section>

        <section class="channel-switcher" id="channel-picker" aria-label="Choose channel">
          <div>
            <p class="eyebrow">Start here</p>
            <h2>Choose a channel to understand what to do next</h2>
            <p class="channel-picker-copy">Each channel has its own signal. Pick one to see its history, rankings and next actions.</p>
          </div>
          <div class="channel-switcher-list" id="channel-switcher-list">
            <button class="channel-switch active" data-channel="all" type="button" hidden>Overview</button>
            <button class="channel-switch" data-channel="linkedin" type="button"><span class="channel-picker-icon">IN</span><span><strong>LinkedIn</strong><small>Conversation and clicks</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="newsletter" type="button"><span class="channel-picker-icon">NL</span><span><strong>Newsletter</strong><small>Opens and clicks</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="website" type="button"><span class="channel-picker-icon">WEB</span><span><strong>Website</strong><small>Visits and actions</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="youtube" type="button"><span class="channel-picker-icon">YT</span><span><strong>YouTube</strong><small>Views and watch time</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="spotify" type="button"><span class="channel-picker-icon">SP</span><span><strong>Spotify</strong><small>Episodes and podcast topics</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="instagram" type="button"><span class="channel-picker-icon">IG</span><span><strong>Instagram</strong><small>Visual format and engagement</small></span><span class="channel-picker-arrow">→</span></button>
            <button class="channel-switch" data-channel="luma" type="button"><span class="channel-picker-icon">LU</span><span><strong>Luma</strong><small>Events and attendance</small></span><span class="channel-picker-arrow">→</span></button>
          </div>
        </section>

        <section class="brief-shell" id="brief-shell" aria-live="polite">
          <div class="brief-heading">
            <div>
              <p class="eyebrow">Weekly content brief</p>
              <h2 id="brief-channel-title">Choose a channel to begin</h2>
            </div>
            <span class="brief-period" id="brief-period">This period</span>
          </div>
          <div class="brief-grid">
            <article class="brief-card happened-card">
              <span class="brief-label">What happened?</span>
              <p class="brief-lead" id="brief-summary">Choose a channel to see the clearest change in your content.</p>
              <p class="brief-evidence" id="brief-evidence"></p>
            </article>
            <article class="brief-card worked-card">
              <span class="brief-label">What worked?</span>
              <div class="worked-list" id="worked-content"></div>
            </article>
            <article class="brief-card action-card">
              <span class="brief-label">What should I do next?</span>
              <p class="brief-lead" id="next-action-title">Choose a channel to get one clear recommendation.</p>
              <p class="brief-evidence" id="next-action-body"></p>
              <button class="primary-button brief-cta" id="next-action-cta" type="button">Use this direction</button>
            </article>
          </div>
          <details class="details-panel">
            <summary>View details</summary>
            <div class="details-copy" id="brief-details"></div>
            <div class="technical-details" id="technical-details"></div>
          </details>
        </section>

        <section class="decision-grid" id="overview-grid"></section>

        <section class="board question-board">
          <div class="board-header">
            <div>
              <h2>Decision check</h2>
              <p>The minimum needed to decide what to do next without getting lost in vanity metrics.</p>
            </div>
          </div>
          <div class="quick-grid" id="quick-check"></div>
        </section>

        <section class="board">
          <div class="board-header">
            <div>
              <h2>Post comparison</h2>
              <p>See which pieces won on attention, action or distribution. Compare posts, not just totals.</p>
            </div>
          </div>
          <div class="top-content-grid" id="top-content"></div>
        </section>

        <section class="channel-stack" id="channels">
          <div class="section-heading">
            <p class="eyebrow">Channel analysis</p>
            <h2>Channel analysis</h2>
          </div>
          <div id="channel-sections"></div>
        </section>

        <section class="board" id="content-intelligence">
          <div class="board-header">
            <div>
              <h2>Content intelligence</h2>
              <p>Patterns by platform, format and available metadata. No topics are invented when the data does not contain them.</p>
            </div>
          </div>
          <div class="intelligence-grid" id="content-intelligence-grid"></div>
        </section>

        <section class="board" id="learnings">
          <div class="board-header">
            <div>
              <h2>Learnings</h2>
              <p>A decision record that separates facts, observations, hypotheses and recommendations.</p>
            </div>
          </div>
          <div class="learning-list" id="learning-list"></div>
        </section>

        <section class="board" id="content-record">
          <div class="board-header">
            <div>
              <h2>Full content record</h2>
              <p>All pieces in the selected period, with thumbnails when the CSV/API provides them.</p>
            </div>
          </div>
          <div class="content-table-wrap">
            <table class="content-table">
              <thead>
                <tr>
                  <th>Content</th>
                  <th>Channel</th>
                  <th>Date</th>
                  <th>Metrics</th>
                  <th>Score</th>
                  <th>Decision</th>
                </tr>
              </thead>
              <tbody id="content-table-body"></tbody>
            </table>
          </div>
        </section>

        <section class="board setup-grid" id="data-health">
          <div>
            <h2>What each channel measures</h2>
            <p class="setup-copy">The metrics used to compare content and decide what to do next.</p>
          </div>
          <div class="metric-reference" aria-label="Metrics to track by channel">
            <div class="metric-reference-head"><strong>Channel</strong><strong>Metrics to track</strong></div>
            <div class="metric-reference-row"><strong>Instagram</strong><span>Reach / Views, Likes, Comments, Shares, Saves, Follower Growth</span></div>
            <div class="metric-reference-row"><strong>LinkedIn</strong><span>Impressions, Clicks, Reactions, Comments, Reposts, Engagement Rate, Follower Growth</span></div>
            <div class="metric-reference-row"><strong>YouTube</strong><span>Views, Watch Time, Average View Duration, Subscribers Gained</span></div>
            <div class="metric-reference-row"><strong>Spotify</strong><span>Plays, Average Consumption Time, Completion Rate, Followers</span></div>
            <div class="metric-reference-row"><strong>Beehiiv</strong><span>Delivered, Open Rate, Click Rate, Unsubscribe Rate, Subscriber Growth</span></div>
            <div class="metric-reference-row"><strong>Luma</strong><span>Page Views, Total Registrations, Going, Check-ins, <b>Show Rate</b> (Check-ins / Going)</span></div>
            <div class="metric-reference-row"><strong>Website</strong><span>Users, Sessions, Page Views, Clicks, Events, Views by page section</span></div>
          </div>
          <div class="queue-list" id="data-health-list"></div>
        </section>
      </div>
    </main>

    <script src="/dashboard/app.js?v=gild-channel-grid-1" type="module"></script>
  </body>
</html>
